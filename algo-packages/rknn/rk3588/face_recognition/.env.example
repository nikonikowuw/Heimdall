# ==============================================================================
# Heimdall 算法包私有调试配置 (RK3588 人脸识别)
#
# 【核心隔离原则】
# 1. 作用域：仅在当前算法包实例生命周期内由 PackageEnv 纯内存加载，绝不调用 std::env::set_var，
#    100% 杜绝多线程竞争与进程级全局环境变量污染。
# 2. 三级优先级阶梯：
#    - 第一级（最高）：宿主显式下发的任务配置（task.parameters）严格受保护，不被 .env 覆盖；
#    - 第二级：当前算法包私有 .env 配置（本地基线与免编译调优）；
#    - 第三级（保底）：算法内部硬编码默认基准值。
# 3. 使用方法：复制本文件为 .env 并在当前目录修改，重启服务或本地工具即刻生效，无需重新编译！
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 模型物理路径覆盖（相对于算法包根目录或绝对路径）
# ------------------------------------------------------------------------------
# 人体检测模型 (默认 YOLOv6n 384x640 RK3588 INT8，输入尺寸 640x384)
# PERSON_DETECTOR_MODEL_PATH=model/yolov6n_384x640_rk3588_i8.rknn

# 视频流人脸检测模型 (默认 SCRFD-500M 384x640 RK3588 混合精度，消除 0.5 截断)
# DETECTOR_MODEL_PATH=model/scrfd_500m_384x640_rk3588_mixed.rknn

# 注册底库人脸检测模型 (默认 SCRFD-2.5G 640x640 RK3588 混合精度，正方形/自拍寸照优化)
# REGISTRATION_DETECTOR_MODEL_PATH=model/scrfd_2.5g_bnkps_640x640_rk3588_mixed.rknn

# 人脸特征向量提取模型 (默认 FaceLiVTv2-L 12xMHLA 大容量模型，可选轻量高帧率 facelivtv2_m_realistic_final_super_rk3588_fp16.rknn)
# EMBEDDER_MODEL_PATH=model/facelivtv2_l_realistic_final_super_rk3588_fp16.rknn

# ------------------------------------------------------------------------------
# 2. RK3588 NPU 核心调度掩码 (0: AUTO, 1: Core0, 2: Core1, 4: Core2, 7: Core0_1_2 全核并行, 默认: 7)
# ------------------------------------------------------------------------------
# RKNN_CORE_MASK=7

# ------------------------------------------------------------------------------
# 2. 算法运行时参数与门控阈值（免编译调优）
# ------------------------------------------------------------------------------
# 人脸检测置信度阈值 (取值范围: [0.0, 1.0]，默认值: 0.6)
# 调优建议：现场光照良好且背景复杂产生误检时调高至 0.65~0.75；夜间低照度漏检时调低至 0.45~0.55
# 注意：该阈值同时作为人脸 track 的建轨门限，调高会同时提高身份链路（best-shot/特征提取）的准入
# DETECTION_CONFIDENCE_THRESHOLD=0.6

# 人体检测置信度阈值 (取值范围: [0.0, 1.0]，默认值: 0.6)
# 说明：人体框仅为人脸与人体的空间关联提供上下文（输出中的人体框），不参与人脸身份判定
# 调优建议：误报大量无关人体框时保持或调高至 0.7；需要更完整的人脸-人体归属关系时调低至 0.4~0.5
# PERSON_CONFIDENCE_THRESHOLD=0.6

# 最小有效人脸边长像素尺寸 (取值范围: >= 1 整数，单位: 像素，默认值: 50)
# 调优建议：过滤画面远景过小的人脸（过小人脸特征提取质量低易误识别）。近景通道可调大到 60~80
# MIN_FACE_SIZE=50

# 综合人脸质量分数门限 (取值范围: [0.0, 1.0]，默认值: 0.5)
# 调优建议：质量门限是人脸特征提取与底库对账的守门人，低于此分数的抓拍不进行识别。
# 若现场误识别多，建议提高至 0.60~0.70
# 【重要】放宽本项时必须同步下调 FUSION_MIN_QUALITY_SCORE：单帧是否真正触发特征提取取
# 两者较大值，只放宽本项会得到「有检测框、有质量分、但没有特征向量」的静默中间态。
# QUALITY_MIN_SCORE=0.5

# 特征提取触发门限 (取值范围: [0.0, 1.0]，默认值: 0.5)
# 说明：决定单帧是否值得消耗一次 EdgeFace NPU 前向，高于 QUALITY_MIN_SCORE 的准入门槛。
# 调优建议：底库比对难以出结果且现场人脸多为侧脸/远景时，与 QUALITY_MIN_SCORE 一起下调至
# 0.30~0.35，让更多合格帧参与时域融合；误识别偏多时保持 0.5 以上，只采信高置信帧。
# FUSION_MIN_QUALITY_SCORE=0.5

# 人脸最大偏航角 (Yaw) 限制 (取值范围: [0.0, 180.0]，单位: 角度，默认值: 25.0)
# 调优建议：水平偏转角度。超过此角度的大侧脸将被丢弃；建议设为 20.0 ~ 25.0
# QUALITY_MAX_YAW=25.0

# 人脸最大俯仰角 (Pitch) 限制 (取值范围: [0.0, 90.0]，单位: 角度，默认值: 30.0)
# 调优建议：垂直低头/仰头角度。监控摄像头俯角大时可适当放宽至 35.0；过大仰角易导致特征畸变
# QUALITY_MAX_PITCH=30.0

# 人脸最大模糊度代理评分限制 (取值范围: [0.0, 1.0]，默认值: 0.7)
# 调优建议：评估人脸模糊程度，模糊度大于该阈值的人脸判定为运动模糊并丢弃；推荐 0.60 ~ 0.70
# 口径说明：当前模糊度是「1 - 检测置信度」的代理量（SCRFD 交付模型不输出关键点分数），
# 因此本阈值实际等价于一条检测分下限（且检测分在综合分里被计两次），调高会连带提升检测要求。
# QUALITY_MAX_BLUR=0.7

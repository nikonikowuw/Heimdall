# ==============================================================================
# Heimdall 算法包私有调试配置 (RK3568 安全帽与违规未戴检测)
#
# 【核心隔离原则】
# 1. 作用域：仅在当前算法包实例生命周期内由 PackageEnv 纯内存加载，绝不调用 std::env::set_var，
#    100% 杜绝多线程竞争与进程级全局环境变量污染。
# 2. 三级优先级阶梯：
#    - 第一级（最高）：宿主显式下发的任务配置（task.parameters）严格受保护，不被 .env 覆盖；
#    - 第二级：当前算法包私有 .env 配置（本地基线与免编译调优）；
#    - 第三级（保底）：算法内部硬编码默认基准值。
# 3. 使用方法：复制本文件为 .env 并在当前目录修改，重启服务或本地工具即刻生效，无需重新编译！
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 模型物理路径覆盖（相对于算法包根目录或绝对路径）
# ------------------------------------------------------------------------------
# 安全帽检测 RKNN 模型 (识别类别: Hardhat / NO-Hardhat)
# MODEL_PATH=model/best_hybrid.rknn

# ------------------------------------------------------------------------------
# 2. 算法运行时参数与阈值（免编译调优）
# ------------------------------------------------------------------------------
# 目标检测置信度阈值 (取值范围: [0.0, 1.0]，默认值: 0.45)
# 调优建议：若施工现场工人和非安全帽物品产生误报，调高到 0.50~0.60；若远景安全帽漏报较多，调低至 0.35~0.40
# CONFIDENCE_THRESHOLD=0.45

# 非极大值抑制 (NMS) 重叠度阈值 (取值范围: [0.0, 1.0]，默认值: 0.45)
# 调优建议：当密集人群工人们重叠站立导致临近安全帽被抑制消除时，提高至 0.50~0.55
# IOU_THRESHOLD=0.45

# 自定义业务告警标签 (可选字符串，默认留空使用模型原生输出类别)
# 调优建议：可用于将算法事件统一规范化为现场特定的告警业务名称
# CUSTOM_ALARM_LABEL="未戴安全帽违规"

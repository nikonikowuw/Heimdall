# ==============================================================================
# Heimdall 算法包私有调试配置 (RK3568 人脸识别)
#
# 【核心隔离原则】
# 1. 作用域：仅在当前算法包实例生命周期内由 PackageEnv 纯内存加载，绝不调用 std::env::set_var，
#    100% 杜绝多线程竞争与进程级全局环境变量污染。
# 2. 三级优先级阶梯：
#    - 第一级（最高）：宿主显式下发的任务配置（task.parameters）严格受保护，不被 .env 覆盖；
#    - 第二级：当前算法包私有 .env 配置（本地基线与免编译调优）；
#    - 第三级（保底）：算法内部硬编码默认基准值。
# 3. 使用方法：复制本文件为 .env 并在当前目录修改，重启服务或本地工具即刻生效，无需重新编译！
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 模型物理路径覆盖（相对于算法包根目录或绝对路径）
# ------------------------------------------------------------------------------
# 人体检测模型 (YOLOv8n COCO，输入尺寸 640x384，类别 0 为 person)
# PERSON_DETECTOR_MODEL_PATH=model/yolov8n-640x384-rk3568.rknn

# 人脸检测模型 (YOLOv8n-face，默认输入尺寸 640x384)
# DETECTOR_MODEL_PATH=model/yolov8n-face-640x384_rk3568_mixed_face.rknn

# 人脸特征向量提取模型 (EdgeFace-xs，默认输入尺寸 112x112，输出 512 维归一化向量)
# EMBEDDER_MODEL_PATH=model/edgeface_xs_gamma_06_rk3568_fp16.rknn

# ------------------------------------------------------------------------------
# 2. 算法运行时参数与门控阈值（免编译调优）
# ------------------------------------------------------------------------------
# 人脸检测置信度阈值 (取值范围: [0.0, 1.0]，默认值: 0.25)
# 调优建议：现场光照良好且背景复杂产生误检时调高至 0.35~0.45；夜间低照度漏检时调低至 0.20
# DETECTION_CONFIDENCE_THRESHOLD=0.25

# 最小有效人脸边长像素尺寸 (取值范围: >= 1 整数，单位: 像素，默认值: 30)
# 调优建议：过滤画面远景过小的人脸（过小人脸特征提取质量低易误识别）。近景通道可调大到 40~50
# MIN_FACE_SIZE=30

# 综合人脸质量分数门限 (取值范围: [0.0, 1.0]，默认值: 0.3)
# 调优建议：质量门限是人脸特征提取与底库对账的守门人，低于此分数的抓拍不进行识别。
# 若现场误识别多，建议提高至 0.45~0.60；若比对难以出结果，放宽至 0.20~0.25
# QUALITY_MIN_SCORE=0.3

# 人脸最大偏航角 (Yaw) 限制 (取值范围: [0.0, 180.0]，单位: 角度，默认值: 45.0)
# 调优建议：水平偏转角度。超过此角度的大侧脸将被丢弃；建议设为 30.0 ~ 45.0
# QUALITY_MAX_YAW=45.0

# 人脸最大俯仰角 (Pitch) 限制 (取值范围: [0.0, 90.0]，单位: 角度，默认值: 30.0)
# 调优建议：垂直低头/仰头角度。监控摄像头俯角大时可适当放宽至 35.0；过大仰角易导致特征畸变
# QUALITY_MAX_PITCH=30.0

# 人脸最大模糊度代理评分限制 (取值范围: [0.0, 1.0]，默认值: 0.7)
# 调优建议：评估人脸模糊程度。模糊度大于该阈值的人脸判定为运动模糊并丢弃；推荐 0.60 ~ 0.70
# QUALITY_MAX_BLUR=0.7

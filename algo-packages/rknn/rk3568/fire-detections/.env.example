# ==============================================================================
# Heimdall 算法包私有调试配置 (RK3568 火灾与烟雾检测)
#
# 【核心隔离原则】
# 1. 作用域：仅在当前算法包实例生命周期内由 PackageEnv 纯内存加载，绝不调用 std::env::set_var，
#    100% 杜绝多线程竞争与进程级全局环境变量污染。
# 2. 三级优先级阶梯：
#    - 第一级（最高）：宿主显式下发的任务配置（task.parameters）严格受保护，不被 .env 覆盖；
#    - 第二级：当前算法包私有 .env 配置（本地基线与免编译调优）；
#    - 第三级（保底）：算法内部硬编码默认基准值。
# 3. 使用方法：复制本文件为 .env 并在当前目录修改，重启服务或本地工具即刻生效，无需重新编译！
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 模型物理路径覆盖（相对于算法包根目录或绝对路径）
# ------------------------------------------------------------------------------
# 烟火检测 RKNN 模型 (优先纯 INT8 模型 model/best_pure.rknn，其次混合量化 model/best_hybrid.rknn)
# MODEL_PATH=model/best_pure.rknn

# ------------------------------------------------------------------------------
# 2. 算法运行时参数与阈值（免编译调优）
# ------------------------------------------------------------------------------
# 目标检测置信度阈值 (取值范围: [0.0, 1.0]，默认值: 0.25)
# 调优建议：烟火检测初期由于火焰可能微小，默认保持较低置信度 0.25，依靠后续时序多帧验证降低误报；
# 若静态背景产生明显误报，可调高到 0.35 ~ 0.50
# CONFIDENCE_THRESHOLD=0.25

# 非极大值抑制 (NMS) 重叠度阈值 (取值范围: [0.0, 1.0]，默认值: 0.45)
# IOU_THRESHOLD=0.45

# 多帧确认滑动窗口大小 (取值范围: >= 1 整数，单位: 帧数，默认值: 5)
# 调优建议：用于时序平滑以过滤偶发单帧抖动。在 15fps 推理频率下，5 帧约为 0.3 秒的决策缓冲
# CONFIRM_WINDOW=5

# 滑动窗口内需命中的最小帧数 (取值范围: 1..=CONFIRM_WINDOW，单位: 帧数，默认值: 3)
# 调优建议：连续 CONFIRM_WINDOW 帧内至少检测到本参数指定次数方确认报警。调大可强力抑制瞬间反光误报
# CONFIRM_THRESHOLD=3

# 时序颜色方差验证阈值 (取值范围: >= 0.0 浮点数，默认值: 50.0)
# 调优建议：火焰的物理特性具有动态闪烁和颜色分布波动（方差大），而静止的路灯、警示灯等稳定光源颜色方差极小。
# 若现场有固定黄色/红色灯光误报，调大此阈值（如 60.0~80.0）可精准过滤稳定光源！
# TEMPORAL_VARIANCE_THRESHOLD=50.0

# 自定义业务告警标签 (可选字符串，默认留空使用 "fire" / "smoke")
# CUSTOM_ALARM_LABEL="明火烟雾火警"

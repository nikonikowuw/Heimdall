{
  "manifest_version": 1,
  "algorithm_id": "face_recognition",
  "version": "1.0.0",
  "name": "EdgeFace Face Recognition (RKNN)",
  "description": "YOLOv8n-face detection and EdgeFace-xs embeddings on Rockchip RK3576 NPU",
  "algorithm_type": "face_recognition",
  "alarm_type_id": "face_recognize",
  "platform_id": "rknn-rk3576",
  "min_adapter_version": "1.0.0",
  "runtime_constraints": {
    "requires_rknn_runtime": true,
    "min_rknnrt_version": "1.5.0"
  },
  "models": {
    "detector": "model/yolov8n-face-640x384_mixed_face.rknn",
    "embedder": "model/edgeface_xs_gamma_06_rk3576_fp16.rknn",
    "embedding_dimension": 512
  },
  "resource_profile": {
    "min_free_memory_mb": 256,
    "fps_tiers": [
      { "fps": 5, "units": 80 },
      { "fps": 15, "units": 200 },
      { "fps": 30, "units": 400 }
    ]
  },
  "self_test": {
    "timeout_ms": 10000,
    "input_mode": "test_image"
  }
}

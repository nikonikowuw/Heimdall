# ==============================================================================
# Heimdall 算法包私有调试配置 (RK3576 通用目标检测)
#
# 【核心隔离原则】
# 1. 作用域：仅在当前算法包实例生命周期内由 PackageEnv 纯内存加载，绝不调用 std::env::set_var，
#    100% 杜绝多线程竞争与进程级全局环境变量污染。
# 2. 三级优先级阶梯：
#    - 第一级（最高）：宿主显式下发的任务配置（task.parameters）严格受保护，不被 .env 覆盖；
#    - 第二级：当前算法包私有 .env 配置（本地基线与免编译调优）；
#    - 第三级（保底）：算法内部硬编码默认基准值。
# 3. 使用方法：复制本文件为 .env 并在当前目录修改，重启服务或本地工具即刻生效，无需重新编译！
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 模型物理路径覆盖（相对于算法包根目录或绝对路径）
# ------------------------------------------------------------------------------
# 通用目标检测 RKNN 模型 (默认输入尺寸 640x384，COCO 80 类别)
# MODEL_PATH=model/yolov8n-640x384-rk3576.rknn

# ------------------------------------------------------------------------------
# 2. 算法运行时参数与阈值（免编译调优）
# ------------------------------------------------------------------------------
# 目标检测置信度阈值 (取值范围: [0.0, 1.0]，默认值: 0.45)
# CONFIDENCE_THRESHOLD=0.45

# 非极大值抑制 (NMS) 重叠度阈值 (取值范围: [0.0, 1.0]，默认值: 0.45)
# IOU_THRESHOLD=0.45

# 目标类别白名单过滤 (逗号分隔的 COCO 类别名称，默认监控 6 类主要交通/人员目标)
# 支持从 COCO 80 类任意挑选，例如:
# - 人员车辆监控: person,car,motorcycle,bicycle,bus,truck
# - 纯人员监控: person
# - 动物入侵监控: dog,cat,horse,sheep,cow,bear
# 留空或不配置时默认放行全部已定义目标
# TARGET_CLASSES=person,car,motorcycle,bicycle,bus,truck

# 自定义业务告警标签 (可选字符串)
# CUSTOM_ALARM_LABEL="目标入侵检测"

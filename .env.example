# ============================================================================
#  Heimdall 本地开发与交叉编译/部署配置 (可选)
# ============================================================================
#
#  说明:
#    复制此文件为 `.env` 即可生效。`.env` 已被 .gitignore 忽略，不会提交到仓库。
#    配置后无需在全局 `~/.ssh/config` 中添加别名，也无需每次敲命令行参数。
#
# ============================================================================

# ── 目标板端主机配置 ──
# 支持纯 IP 地址（自动以 root 连接）、user@ip 或已有 SSH 别名
RK3568_HOST=192.168.19.69
RK3576_HOST=192.168.18.229

# ── 通用/备用主机 (未指定芯片专属时生效) ──
# RKNN_HOST=root@192.168.1.100

# ── 部署路径 ──
# RKNN_DEPLOY_PATH=/opt/heimdall

# ── SSH 端口 ──
# RKNN_SSH_PORT=22
